<Window x:Class="DoubleMark.Desktop.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация DoubleMark"
        Width="520" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="Создать аккаунт" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
            <TextBlock Text="Используйте те же данные, что и на сайте DoubleMark."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <TextBlock Text="Email" Style="{StaticResource MetricLabel}" Margin="0,0,0,6"/>
            <TextBox x:Name="EmailText" Style="{StaticResource InputBox}" Margin="0,0,0,12"/>

            <TextBlock Text="Пароль (мин. 8 символов)" Style="{StaticResource MetricLabel}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PasswordText" Style="{StaticResource InputPasswordBox}" Margin="0,0,0,12"/>

            <TextBlock Text="Организация" Style="{StaticResource MetricLabel}" Margin="0,0,0,6"/>
            <TextBox x:Name="CompanyText" Style="{StaticResource InputBox}" Margin="0,0,0,16"/>

            <TextBlock Text="ИНН (10 или 12 цифр, необязательно)" Style="{StaticResource MetricLabel}" Margin="0,0,0,6"/>
            <TextBox x:Name="InnText" Style="{StaticResource InputBox}" Margin="0,0,0,12"/>

            <TextBlock Text="Телефон" Style="{StaticResource MetricLabel}" Margin="0,0,0,6"/>
            <TextBox x:Name="PhoneText" Style="{StaticResource InputBox}" Margin="0,0,0,16"/>

            <CheckBox x:Name="ConsentCheck"
                      Content="Даю согласие на обработку персональных данных"
                      Margin="0,0,0,10"/>
            <CheckBox x:Name="OfferCheck"
                      Content="Принимаю публичную оферту"
                      Margin="0,0,0,16"/>

            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}"
                       Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <UniformGrid Columns="2">
                <Button Style="{StaticResource SecondaryButton}" Content="Отмена" Click="OnCancelClick" Margin="0,0,6,0"/>
                <Button x:Name="RegisterButton" Style="{StaticResource PrimaryButton}" Content="Зарегистрироваться" Click="OnRegisterClick" Margin="6,0,0,0"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
