# Copy to .env on the VPS (never commit .env)

POSTGRES_DB=doublemark
POSTGRES_USER=doublemark
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

Jwt__Issuer=DoubleMark
Jwt__Audience=DoubleMark.Desktop
Jwt__SigningKey=CHANGE_ME_at_least_32_random_characters_long
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=30

Mail__SmtpHost=smtp.timeweb.ru
Mail__SmtpPort=465
Mail__SmtpUser=support@doublemark.ru
Mail__SmtpPass=CHANGE_ME_smtp_password
Mail__MailFrom=support@doublemark.ru
Mail__SiteBaseUrl=https://doublemark.ru
Mail__SmtpSecure=true

# Alfa-Bank acquiring (leave empty + SandboxMode=true until merchant contract is signed)
AlphaBank__UserName=
AlphaBank__Password=
AlphaBank__ApiBaseUrl=https://pay.alfabank.ru/payment/rest/
AlphaBank__ReturnUrl=https://doublemark.ru/checkout/result
AlphaBank__WebhookSecret=
AlphaBank__SandboxMode=true
