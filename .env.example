# Local DoubleMark backend (Docker Postgres + API)
# Copy to .env and change passwords before any non-local use.

POSTGRES_DB=doublemark
POSTGRES_USER=doublemark
POSTGRES_PASSWORD=doublemark_dev_change_me
POSTGRES_PORT=5432

# Used by DoubleMark.Api (also overridable in appsettings.Development.json)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=doublemark;Username=doublemark;Password=doublemark_dev_change_me

Jwt__Issuer=DoubleMark
Jwt__Audience=DoubleMark.Desktop
Jwt__SigningKey=DoubleMark-Local-Dev-Signing-Key-Change-Me-32chars-Min
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=30

Mail__SmtpHost=
Mail__SmtpPort=587
Mail__SmtpUser=
Mail__SmtpPass=
Mail__MailFrom=support@doublemark.ru
Mail__SiteBaseUrl=https://doublemark.ru
Mail__SmtpSecure=true

ASPNETCORE_URLS=http://localhost:5080

# Desktop production/release default is https://api.doublemark.ru
DOUBLEMARK_API_URL=http://localhost:5080
